# Agent Odysseus (the team's shared agent identity). `dev-tools/installer/p4m configure` writes
# odysseus.env (git-ignored) from this template; you can also copy it and fill it in by hand.

# Fine-grained token of the agent-odysseus GitHub account (see odysseus/README.md).
GH_TOKEN=

# Optional overrides (defaults shown).
# ODYSSEUS_NAME=Agent Odysseus
# ODYSSEUS_EMAIL=agent.odysseus@projects4.me
# ODYSSEUS_SSH_KEY=$HOME/.ssh/agent_odysseus
