# gaia-mcp settings. Copy to gaia-mcp.env (git-ignored) and fill in.

# Gaia API and Prometheus UI. Defaults are the local p4m stack.
GAIA_URL=https://api.local-projects4.me
GAIA_UI_URL=https://app.local-projects4.me

# The agent's email in Projects4Me (used to find its user record).
GAIA_EMAIL=

# The agent's own OAuth credentials (client_credentials grant).
GAIA_CLIENT_ID=
GAIA_CLIENT_SECRET=

# Or sign in as a user agent with the password grant: set GAIA_PASSWORD (with GAIA_EMAIL above) and use the
# app's shared OAuth client (prometheus/config/environment.js) as GAIA_CLIENT_ID/GAIA_CLIENT_SECRET.
# GAIA_PASSWORD=

# Optional: CA bundle for a self-signed proxy, if the system store doesn't trust it.
# GAIA_CA_FILE=

# Milestone new issues go into when none is given (backlog if the project has none).
GAIA_DEFAULT_MILESTONE=Claude-v1
