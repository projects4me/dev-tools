#!/usr/bin/env sh
# The Nestor UI (brainstorm ideas with Agent Nestor, who runs in Talos): see README.md
# pwd -W: a Windows path, because the script path is no longer converted for python (see MSYS_NO_PATHCONV below)
DIR="$(cd "$(dirname "$0")" && { pwd -W 2>/dev/null || pwd; })"
# Python: `python` on Windows (Git Bash; `python3` there may be the Microsoft Store stub, which hangs),
# `python3` elsewhere (often the only one on Linux); whichever exists if that one doesn't.
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) PY=python ;; *) PY=python3 ;; esac
command -v "$PY" >/dev/null 2>&1 || { [ "$PY" = python ] && PY=python3 || PY=python; }
# Git Bash rewrites an argument that starts with / (a /regex/ filter) into a Windows path before a native program gets it.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
# The runtime copy of dev-tools (`p4m runtime`) runs main's tooling while this checkout is worked;
# P4M_RUNTIME=off runs this copy.
RT="$DIR/../../.dev-tools-runtime/nestor"
[ "${P4M_RUNTIME:-}" = off ] || [ ! -f "$RT/nestor.py" ] || DIR="$RT"
exec "$PY" "$DIR/nestor.py" "$@"
